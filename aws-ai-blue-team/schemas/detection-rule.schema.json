{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Detection Rule",
  "type": "object",
  "required": ["id", "name", "description", "severity", "data_source", "detection", "classification_weight"],
  "properties": {
    "id": {"type": "string", "pattern": "^DETECT-[0-9]{3}$"},
    "name": {"type": "string", "minLength": 5},
    "description": {"type": "string", "minLength": 10},
    "author": {"type": "string", "enum": ["human", "threat-hunter", "red-team"]},
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "informational"]},
    "mitre_tactic": {"type": "string"},
    "mitre_technique": {"type": "string"},
    "data_source": {"type": "string", "enum": ["cloudtrail", "guardduty", "securityhub", "vpc-flow-logs"]},
    "detection": {
      "type": "object",
      "properties": {
        "event_source": {"type": "string"},
        "event_name": {"type": "array", "items": {"type": "string"}},
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "operator", "value"],
            "properties": {
              "field": {"type": "string"},
              "operator": {"type": "string", "enum": ["equals", "contains", "starts_with", "in_cidr", "regex", "gte", "lte"]},
              "value": {}
            }
          }
        }
      }
    },
    "classification_weight": {"type": "integer", "minimum": 1, "maximum": 50},
    "response": {"type": "string"}
  }
}
